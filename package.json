{
  "name": "@nanostackorg/design-system",
  "version": "0.2.0-beta.5",
  "description": "Typed, accessible UI building blocks for Nanostack products",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/nanostack-dev/nanostack-design-system#readme",
  "bugs": {
    "url": "https://github.com/nanostack-dev/nanostack-design-system/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "beta"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.16.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js",
      "default": "./dist/components/*.js"
    },
    "./blocks/*": {
      "types": "./dist/blocks/*.d.ts",
      "import": "./dist/blocks/*.js",
      "default": "./dist/blocks/*.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js",
      "default": "./dist/theme.js"
    },
    "./styles.css": "./dist/styles.css",
    "./adapters/*": {
      "types": "./dist/adapters/*.d.ts",
      "import": "./dist/adapters/*.js",
      "default": "./dist/adapters/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node scripts/copy-styles.mjs",
    "build:docs": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check": "pnpm registry:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm build:docs",
    "registry:build": "node scripts/build-registry.mjs",
    "registry:check": "node scripts/build-registry.mjs --check",
    "test:package": "pnpm build && node scripts/test-package.mjs",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@clerk/clerk-react": "^5.61.3",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.4",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.13",
    "cmdk": "^1.1.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@clerk/clerk-react": "^5.61.3",
    "@eslint/js": "^9.39.4",
    "@phosphor-icons/react": "^2.1.10",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "jsdom": "^29.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^7.3.1",
    "vitest": "^4.1.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nanostack-dev/nanostack-design-system.git"
  },
  "peerDependenciesMeta": {
    "@clerk/clerk-react": {
      "optional": true
    }
  }
}
